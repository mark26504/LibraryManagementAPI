# JWT Configuration
Jwt__SecretKey=REPLACE_WITH_GENERATED_SECRET_KEY
Jwt__Issuer=LibraryManagement.API
Jwt__Audience=LibraryManagement.Client
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Database Configuration
ConnectionStrings__DefaultConnection=Server=library-sqlserver,1433;Database=LibraryManagement;User Id=sa;Password=REPLACE_WITH_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True

# Email Configuration - Local Mailpit
EmailOptions__SmtpServer=mailpit
EmailOptions__Port=1025
EmailOptions__SenderName="Library Management"
EmailOptions__SenderEmail=noreply@library.example.com
EmailOptions__Username=
EmailOptions__Password=
EmailOptions__FrontendBaseUrl=http://localhost:4200
EmailOptions__UseLocalSmtp=true