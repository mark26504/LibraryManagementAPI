        {
          "name": "Confirm Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const link = pm.environment.get(\"emailLinkUrl\") || \"\";\r\n\r\nconst getParam = (name) => {\r\n    const qs = link.split(\"?\")[1] || \"\";\r\n    const pair = qs.split(\"&\").find(p => p.startsWith(name + \"=\"));\r\n    return pair ? decodeURIComponent(pair.slice(name.length + 1)) : \"\";\r\n};\r\n\r\npm.environment.set(\"emailToken\", getParam(\"token\"));\r\npm.environment.set(\"emailLinkEmail\", getParam(\"email\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{emailLinkEmail}}\",\r\n  \"token\": \"{{emailToken}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/confirm-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "confirm-email"
              ]
            }
          },
          "response": []
        },
